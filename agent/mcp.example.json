{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "obscura": {
      "type": "stdio",
      "command": "C:/Tools/obscura/obscura.exe",
      "args": ["mcp"]
    },
    "camofox": {
      "type": "stdio",
      "command": "<USERPROFILE>/AppData/Roaming/npm/camofox-mcp.cmd",
      "env": {
        "CAMOFOX_URL": "http://127.0.0.1:9377"
      }
    },
    "x64dbg": {
      "type": "stdio",
      "command": "C:/Tools/x64dbgmcp/.venv/Scripts/python.exe",
      "args": ["C:/Tools/x64dbgmcp/src/x64dbg.py"]
    },
    "cheat-engine": {
      "type": "stdio",
      "command": "C:/Tools/cheat-engine-server-python/.venv/Scripts/python.exe",
      "args": ["C:/Tools/cheat-engine-server-python/server/main.py", "--read-only"],
      "cwd": "C:/Tools/cheat-engine-server-python"
    },
    "ghidra": {
      "type": "stdio",
      "command": "C:/Tools/ghidra-mcp/.venv/Scripts/bridge-mcp-ghidra.exe",
      "cwd": "C:/Tools/ghidra-mcp"
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "cua-driver": {
      "type": "stdio",
      "command": "<USERPROFILE>/AppData/Local/Programs/Cua/cua-driver/bin/cua-driver.exe",
      "args": ["mcp"]
    },
    "markitdown": {
      "type": "stdio",
      "command": "<USERPROFILE>/.local/bin/markitdown-mcp.exe"
    },
    "semble": {
      "type": "stdio",
      "command": "<USERPROFILE>/.local/bin/semble.exe"
    },
    "code-review-graph": {
      "type": "stdio",
      "command": "<USERPROFILE>/AppData/Roaming/Python/Python314/Scripts/code-review-graph.exe",
      "args": ["serve"],
      "cwd": "<USERPROFILE>"
    },
    "octocode": {
      "type": "stdio",
      "command": "<USERPROFILE>/AppData/Roaming/npm/octocode-mcp.cmd"
    },
    "serena": {
      "type": "stdio",
      "command": "<USERPROFILE>/.local/bin/serena.exe",
      "args": ["start-mcp-server", "--project-from-cwd", "--enable-web-dashboard", "false", "--open-web-dashboard", "false"]
    },
    "openai-websearch": {
      "type": "stdio",
      "command": "C:/Tools/openai-websearch-mcp/.venv/Scripts/python.exe",
      "args": ["-m", "openai_websearch_mcp.cli", "serve"],
      "cwd": "C:/Tools/openai-websearch-mcp"
    },
    "exa": {
      "type": "stdio",
      "command": "<USERPROFILE>/AppData/Roaming/npm/exa-mcp-server.cmd"
    }
  },
  "disabledServers": ["windows-mcp"]
}
