{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "x64dbg": {
      "type": "stdio",
      "command": "C:/Tools/x64dbgmcp/.venv/Scripts/python.exe",
      "args": ["C:/Tools/x64dbgmcp/src/x64dbg.py"]
    },
    "cheat-engine": {
      "type": "stdio",
      "command": "C:/Tools/cheat-engine-server-python/.venv/Scripts/python.exe",
      "args": ["C:/Tools/cheat-engine-server-python/server/main.py", "--read-only"],
      "cwd": "C:/Tools/cheat-engine-server-python"
    },
    "ghidra": {
      "type": "stdio",
      "command": "C:/Tools/ghidra-mcp/.venv/Scripts/bridge-mcp-ghidra.exe",
      "cwd": "C:/Tools/ghidra-mcp"
    }
  },
  "disabledServers": [
    "obscura", "camofox", "deepwiki", "microsoft-learn", "cua-driver", "markitdown",
    "semble", "code-review-graph", "octocode", "serena", "openai-websearch", "exa",
    "windows-mcp", "chrome-devtools", "codegraph", "github", "repomix", "everything-search",
    "cua", "tavily", "parallel-search", "node_repl"
  ]
}
